{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pl3-staging-api",
  "main": "worker-api-candidate.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pl3-staging",
      "database_id": "cc08ca47-1b59-435c-8ac9-11d0a1c703e9"
    }
  ],
  "vars": {
    "GMAIL_SENDER": "petitelueur.pl@gmail.com",
    "PL3_ADMIN_EMAIL": "petitelueur.pl@gmail.com",
    "PL3_SYNC_ALLOW_QA": "true",
    "PL3_SYNC_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbzd6MP0MveFRr0FtOsq5I81Om6y8jJuWuCLFlNYX_j9trPwrTAWSO9wkpUFdtozH7Um9w/exec"
  },
  "secrets": {
    "required": [
      "GMAIL_CLIENT_ID",
      "GMAIL_CLIENT_SECRET",
      "GMAIL_REFRESH_TOKEN",
      "OTP_PEPPER",
      "SESSION_SECRET"
    ]
  }
}
