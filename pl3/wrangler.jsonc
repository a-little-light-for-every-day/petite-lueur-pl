{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pl3-staging-api",
  "main": "worker-api-candidate.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pl3-staging",
      "database_id": "cc08ca47-1b59-435c-8ac9-11d0a1c703e9"
    }
  ],
  "vars": {
    "GMAIL_SENDER": "petitelueur.pl@gmail.com",
    "PL3_ADMIN_EMAIL": "petitelueur.pl@gmail.com",
    "PL3_OPS_MAIL_ENABLED": "true",
    "PL3_OPS_SYNC_ENABLED": "false",
    "PL3_SYNC_ALLOW_QA": "true",
    "PL3_SYNC_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbzd6MP0MveFRr0FtOsq5I81Om6y8jJuWuCLFlNYX_j9trPwrTAWSO9wkpUFdtozH7Um9w/exec",
    "PL3_FORMAL_ALLOWED_GROUP_ID": "PL3-FORMAL-REHEARSAL-01",
    "PL3_FORMAL_SHEETS_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbxb01ZEmkSUxRqdHNaWNv3LJUTBoItk6mHQ7tieQ6tWtSt_CPDdelayADy7o1dtB-27/exec",
    "PL3_FORMAL_NOTION_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbxb01ZEmkSUxRqdHNaWNv3LJUTBoItk6mHQ7tieQ6tWtSt_CPDdelayADy7o1dtB-27/exec"
  },
  "secrets": {
    "required": [
      "GMAIL_CLIENT_ID",
      "GMAIL_CLIENT_SECRET",
      "GMAIL_REFRESH_TOKEN",
      "OTP_PEPPER",
      "SESSION_SECRET"
    ]
  },
  "triggers": {"crons": ["*/5 * * * *"]},
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}