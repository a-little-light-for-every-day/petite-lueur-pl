function operationsDoPost_(raw){try{const p=opsConfig_(),v=opsVerify_(raw,p);if(p.qa&&(v.projection.kind!=='benefit'||!v.projection.document.star_trace.group_id.startsWith('PL3-QA-')))throw Error('OPS_QA_SCOPE_INVALID');const lock=LockService.getScriptLock();if(!lock.tryLock(20000))throw Error('OPS_BUSY');try{return opsResponse_(v.destination==='sheets'?opsSheets_(v,p):opsNotion_(v,p));}finally{lock.releaseLock();}}catch(e){return opsResponse_({ok:false,conflict:false,error_code:/^OPS_[A-Z_]+$/.test(String(e.message))?e.message:'OPS_'+formalErrorCode_(e)});}}

// Owner-run access diagnostics: outputs no customer content or credentials.
function operationsSelfCheck(){const p=opsConfig_(),result={qa:p.qa,sheets:false,notion_orders:false,notion_requests:false,notion_benefit:false};try{const bot=formalNotionCall_(p,'get','/users/me');result.notion_connection_name=bot.name;result.notion_connection_id=bot.id;}catch(e){result.notion_connection_error=formalErrorCode_(e);}try{SpreadsheetApp.openById(p.bookId).getSheets();result.sheets=true;}catch(e){result.sheets_error=formalErrorCode_(e);}for(const [key,ds]of [['notion_orders',p.qa?null:OPS_ORDER_SOURCE],['notion_requests',p.qa?null:OPS_REQUEST_SOURCE],['notion_benefit',p.benefitSource]])if(ds)try{const d=formalNotionCall_(p,'get','/data_sources/'+ds);result[key]=!!d.id;}catch(e){result[key+'_error']=formalErrorCode_(e);}console.log(JSON.stringify(result));return result;}
