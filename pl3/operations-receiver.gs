/** PL3 operations receiver. Appended to the existing isolated receiver project.
 * Uses the existing server-side HMAC secret and Notion integration token.
 * No credentials, bank transfer, purchase, or customer email execution is exposed.
 * Original business workbook permissions were checked private before enabling.
 */
const OPS_BOOK_ID='1Ts9N_UCnn5YITrT6M3CmliKswB78q6gtoxQR9zNkEPI';
const OPS_ORDER_SOURCE='8c7c6206-6e5a-4850-aac6-712d261432a5';
const OPS_REQUEST_SOURCE='2e870f14-4ca7-4fde-bad8-39e30dea5e25';
const OPS_HEADERS=['entity_id','ops_version','sha256','amount_twd','status','summary','document_json','updated_at'];
function opsPlain_(p){return (p&&p[p.type]||[]).map(x=>x.plain_text||x.text&&x.text.content||'').join('');}
function opsText_(s){const t=String(s||'');if(t.length>160000)throw Error('OPS_PAYLOAD_LIMIT');const out=[];for(let i=0;i<t.length;i+=1900)out.push({type:'text',text:{content:t.slice(i,i+1900)}});return out;}
function opsResponse_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function opsConfig_(){const p=PropertiesService.getScriptProperties();const secret=p.getProperty('PL3_FORMAL_SYNC_SECRET'),token=p.getProperty('PL3_FORMAL_NOTION_TOKEN');if(!secret||!token)throw Error('OPS_CONFIG_MISSING');return {secret,PL3_FORMAL_NOTION_TOKEN:token};}
function opsVerify_(raw,p){if(!raw||typeof raw.body!=='string'||raw.body.length>180000||!/^[a-f0-9]{64}$/.test(raw.signature||''))throw Error('OPS_SIGNATURE_INVALID');const expected=formalHex_(Utilities.computeHmacSha256Signature(raw.body,p.secret,Utilities.Charset.UTF_8));let bad=0;for(let i=0;i<64;i++)bad|=expected.charCodeAt(i)^raw.signature.charCodeAt(i);if(bad)throw Error('OPS_SIGNATURE_INVALID');const v=JSON.parse(raw.body);if(v.protocol!=='pl3-operations-v1'||!['notion','sheets'].includes(v.destination)||!['order','request'].includes(v.projection&&v.projection.kind)||v.record_id!==v.projection.record_id||v.event_id!=='ops:'+v.projection.kind+':'+v.projection.hash||!Number.isFinite(Date.parse(v.issued_at))||Math.abs(Date.now()-Date.parse(v.issued_at))>600000||!Number.isInteger(v.version))throw Error('OPS_MESSAGE_INVALID');return v;}
function opsCanonical_(x){if(x===null||typeof x!=='object')return JSON.stringify(x);if(Array.isArray(x))return '['+x.map(opsCanonical_).join(',')+']';return '{'+Object.keys(x).sort().map(k=>JSON.stringify(k)+':'+opsCanonical_(x[k])).join(',')+'}';}
function opsRows_(v){const d=v.projection.document;const rows=[];const put=(kind,x)=>{const doc=opsCanonical_(x);if(doc.length>45000)throw Error('OPS_SHEET_CELL_LIMIT');rows.push({kind,id:String(x.id),amount:Number.isSafeInteger(x.amount_twd)?x.amount_twd:Number.isSafeInteger(x.goods_twd)?x.goods_twd:null,status:String(x.live_status||x.status||''),summary:String(x.name||x.description||x.official_order||x.tracking||x.phase||x.transaction_id||x.id).slice(0,500),json:doc});};
 if(v.projection.kind==='request'){put('詢價委託',d.request);return rows;}put('客單',{...d.order,live_status:d.status});for(const b of d.invoices)put('帳款',b);for(const r of d.receipts)put('收款',r);for(const a of d.allocations)put('款項分配',a);for(const r of d.refunds)put('退款',r);for(const p of d.purchases)put('官方採購',p);for(const p of d.shipments)put('物流出貨',p);for(const n of d.notices)put('通知紀錄',n);return rows;}
function opsSheetHash_(cells){return formalHash_(JSON.stringify([cells[0],Number(cells[1]),cells[3]===''?null:Number(cells[3]),String(cells[4]||''),String(cells[5]||''),String(cells[6]||'')]));}
function opsSheets_(v){const book=SpreadsheetApp.openById(OPS_BOOK_ID),managed=opsRows_(v);let revision=null;const cache={};for(const item of managed){let tab=cache[item.kind];if(!tab){const sheet=formalTab_(book,'PL3 營運｜'+item.kind,OPS_HEADERS);tab=cache[item.kind]={sheet,rows:formalRows_(sheet)};}const safeId=/^[=+@-]/.test(item.id)?'\u200B'+item.id:item.id;const matches=tab.rows.filter(r=>String(r.values[0])===safeId);if(matches.length>1)return{ok:false,conflict:true,error_code:'OPS_DUPLICATE_SHEET_ID'};const old=matches[0];if(old&&opsSheetHash_(old.values)!==old.values[2])return{ok:false,conflict:true,error_code:'OPS_SHEET_MANUAL_EDIT'};const safeSummary=/^[=+@-]/.test(item.summary)?'\u200B'+item.summary:item.summary;const cells=[safeId,v.version,'',item.amount,item.status,safeSummary,item.json,new Date().toISOString()];cells[2]=opsSheetHash_(cells);if(old&&Number(old.values[1])>v.version&&old.values[6]!==item.json)return{ok:false,conflict:true,error_code:'OPS_STALE_VERSION'};if(!old||old.values[6]!==item.json){if(old)tab.sheet.getRange(old.row,1,1,cells.length).setValues([cells]);else{tab.sheet.appendRow(cells);tab.rows.push({row:tab.sheet.getLastRow(),values:cells});}}if(item.kind==='客單'||item.kind==='詢價委託')revision=old&&old.values[6]===item.json?old.values[2]:cells[2];}SpreadsheetApp.flush();return{ok:true,ack_event_id:v.event_id,destination:'sheets',remote_id:v.record_id,remote_revision:revision||v.projection.hash};}
function opsEnsureSchema_(p,ds){const data=formalNotionCall_(p,'get','/data_sources/'+ds),properties={};for(const [name,type]of Object.entries({'PL3同步版本':'rich_text','PL3營運快照':'rich_text','PL3一補待收':'number','PL3二補待收':'number','PL3核帳狀態':'rich_text'}))if(!data.properties[name])properties[name]={[type]:{}};if(Object.keys(properties).length)formalNotionCall_(p,'patch','/data_sources/'+ds,{properties});}
function opsLegacyBaselineMatches_(page,o){const p=page.properties||{};return Number(p['商品款']&&p['商品款'].number)===o.goods_twd&&String(p.Email&&p.Email.email||'').toLowerCase()===String(o.email||'').toLowerCase()&&(!o.source_status||p['狀態']&&p['狀態'].select&&p['狀態'].select.name===o.source_status)&&(!o.source_payment_status||p['付款狀態']&&p['付款狀態'].select&&p['付款狀態'].select.name===o.source_payment_status)&&(!o.raw_item_text||opsPlain_(p['商品明細'])===o.raw_item_text);}
function opsOrderProperties_(d,current,event){const o=d.order,first=d.invoices.find(b=>b.phase==='first'),second=d.invoices.find(b=>b.phase==='second');const props={'訂單編號':{title:opsText_(o.id)},'網站訂單識別碼':{rich_text:opsText_(o.id)},'Email':{email:o.email||null},'商品款':{number:o.goods_twd},'PL3同步版本':{rich_text:opsText_(event)},'PL3營運快照':{rich_text:opsText_(opsCanonical_(d))},'PL3一補待收':{number:first&&first.finalized?first.outstanding_twd:null},'PL3二補待收':{number:second&&second.finalized?second.outstanding_twd:null},'PL3核帳狀態':{rich_text:opsText_(first&&first.finalized&&first.outstanding_twd===null?'歷史已核對／入帳證據待補；不可催繳':'依PL3分階段帳款與實收分配核對')}};
 const canonical=['訂購申請待確認','商品款待確認','申請已撤回','待第一階段付款','第一階段付款待核對','已付款／訂單正式成立','已向日本商店下單','預購等待中','日本倉庫已到貨','國際運送中','商品已抵台','配送方式待確認','等待第二次付款','第二階段付款待核對','二補逾期','等待收件資料','台灣已寄出','已完成','官方缺貨','官方砍單','已取消','退款處理中','已退款','逾期保管','物流異常','售後處理中'];const mapped={'海外倉庫已到貨':'日本倉庫已到貨','商品抵台／待二補結算':'商品已抵台','抵台／待出貨':'商品已抵台','部分已寄出':'台灣已寄出','已收款／待採購':'已付款／訂單正式成立','部分已採購':'已向日本商店下單','取消／缺貨歷史':o.source_status||'已取消'};const status=canonical.includes(d.status)?d.status:mapped[d.status]||o.source_status||'訂購申請待確認';if(canonical.includes(status))props['狀態']={select:{name:status}};
 if(o.items.length)props['商品明細']={rich_text:opsText_(o.items.map(l=>l.name+(l.variant?'｜'+l.variant:'')+' ×'+l.quantity).join('；'))};
 if(second&&second.finalized){props['第二次付款']={number:second.amount_twd};if(second.outstanding_twd===0)props['付款狀態']={select:{name:'第二次付款已核對'}};else if(second.outstanding_twd>0&&second.channel!=='cod')props['付款狀態']={select:{name:'等待第二次付款'}};}
 if(!props['付款狀態']&&first&&first.finalized){if(first.outstanding_twd===0)props['付款狀態']={select:{name:'第一階段已核對'}};else if(first.outstanding_twd>0&&first.channel!=='cod')props['付款狀態']={select:{name:'待第一階段付款'}};}
 const sent=d.notices.filter(n=>n.status==='sent');if(sent.length){const old=current&&current.properties&&current.properties['通知狀態']&&current.properties['通知狀態'].select&&current.properties['通知狀態'].select.name||'';const rank={'第一階段付款已通知':1,'第二階段付款已通知':2,'出貨已通知':3};let level=rank[old]||0;for(const n of sent)level=Math.max(level,n.kind==='shipping'?3:d.invoices.some(b=>(n.invoice_ids||[]).includes(b.id)&&b.phase==='second')?2:1);props['通知狀態']={select:{name:['','第一階段付款已通知','第二階段付款已通知','出貨已通知'][level]}};}
 return props;}
function opsRequestProperties_(d,event){const r=d.request;return {'許願編號':{title:opsText_(r.id)},'Email':{email:r.email},'商品名稱':{rich_text:opsText_(r.description)},'商品網址':{url:r.product_url},'狀態':{select:{name:({pending:'待主購確認',quoted:'已報價',accepted:'已轉商品',declined:'已取消／結案',completed:'已取消／結案'})[r.status]||'待主購確認'}},'台幣試算':{number:r.quote?r.quote.total_twd:null},'顧客備註':{rich_text:opsText_('服務：'+r.kind+'；數量：'+r.quantity+'；'+r.note+(r.order_id?'；已對應客單：'+r.order_id:''))},'PL3同步版本':{rich_text:opsText_(event)},'PL3營運快照':{rich_text:opsText_(opsCanonical_(d))}};}
function opsPropsMatch_(page,expected){const props=page.properties||{};return Object.keys(expected).every(k=>{const v=expected[k],p=props[k];if(!p)return false;if(v.title)return opsPlain_(p)===v.title.map(x=>x.text.content).join('');if(v.rich_text)return opsPlain_(p)===v.rich_text.map(x=>x.text.content).join('');if(Object.prototype.hasOwnProperty.call(v,'number'))return p.number===v.number;if(v.select)return p.select&&p.select.name===v.select.name;if(Object.prototype.hasOwnProperty.call(v,'email'))return (p.email||null)===(v.email||null);if(Object.prototype.hasOwnProperty.call(v,'url'))return p.url===v.url;return false;});}
function opsNotion_(v,p){const pr=v.projection,ds=pr.kind==='order'?OPS_ORDER_SOURCE:OPS_REQUEST_SOURCE,title=pr.kind==='order'?'訂單編號':'許願編號',id=pr.kind==='order'?pr.document.order.id:pr.document.request.id;opsEnsureSchema_(p,ds);let current=null;
 if(pr.source_id){current=formalNotionCall_(p,'get','/pages/'+pr.source_id);if(current.parent&&current.parent.data_source_id!==ds)throw Error('OPS_NOTION_PARENT_MISMATCH');}else{const query=formalNotionCall_(p,'post','/data_sources/'+ds+'/query',{filter:{property:title,title:{equals:id}},page_size:2});if(!Array.isArray(query.results)||query.results.length>1)return{ok:false,conflict:true,error_code:'OPS_DUPLICATE_NOTION_ID'};current=query.results[0]||null;}
 const props=pr.kind==='order'?opsOrderProperties_(pr.document,current,v.event_id):opsRequestProperties_(pr.document,v.event_id);
 if(current&&opsPlain_(current.properties['PL3同步版本'])===v.event_id){if(!opsPropsMatch_(current,props))return{ok:false,conflict:true,error_code:'OPS_NOTION_MANUAL_EDIT'};return{ok:true,ack_event_id:v.event_id,destination:'notion',remote_id:current.id,remote_revision:current.last_edited_time};}
 if(current){const sameId=v.expected_remote_id&&String(v.expected_remote_id).replace(/-/g,'')===current.id.replace(/-/g,'');const sameTime=v.expected_remote_revision&&Date.parse(v.expected_remote_revision)===Date.parse(current.last_edited_time);const initialLegacy=pr.kind==='order'&&pr.source_id&&!opsPlain_(current.properties['PL3同步版本'])&&v.expected_remote_revision&&Math.floor(Date.parse(v.expected_remote_revision)/1000)===Math.floor(Date.parse(current.last_edited_time)/1000)&&opsLegacyBaselineMatches_(current,pr.document.order);if(!sameId||!(sameTime||initialLegacy))return{ok:false,conflict:true,error_code:'OPS_NOTION_REVISION_CHANGED'};}
 else if(v.expected_remote_id||v.expected_remote_revision)return{ok:false,conflict:true,error_code:'OPS_NOTION_MISSING'};
 const saved=current?formalNotionCall_(p,'patch','/pages/'+current.id,{properties:props}):formalNotionCall_(p,'post','/pages',{parent:{type:'data_source_id',data_source_id:ds},properties:props});if(!saved.id||!saved.last_edited_time)throw Error('OPS_NOTION_ACK_INVALID');return{ok:true,ack_event_id:v.event_id,destination:'notion',remote_id:saved.id,remote_revision:saved.last_edited_time};}
function operationsDoPost_(raw){try{const p=opsConfig_(),v=opsVerify_(raw,p),lock=LockService.getScriptLock();if(!lock.tryLock(20000))throw Error('OPS_BUSY');try{return opsResponse_(v.destination==='sheets'?opsSheets_(v):opsNotion_(v,p));}finally{lock.releaseLock();}}catch(e){return opsResponse_({ok:false,conflict:false,error_code:/^OPS_[A-Z_]+$/.test(String(e.message))?e.message:'OPS_RECEIVER_UNAVAILABLE'});}}
